{
  "compilerOptions": {
    // --- Emit target: Node 24, native ESM ---
    "target": "es2024",
    "lib": ["es2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    // Source imports `./x.mts` so Node can run it directly; tsc rewrites those
    // specifiers to `./x.mjs` on emit.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,

    // strict is already on by default
    // Several dependencies ship .d.ts files that do not type-check on their own
    // (e.g. @anthropic-ai/foundry-sdk narrows `models` to `undefined`).
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    // Keeps the source runnable directly via Node's type stripping (`pnpm dev`).
    "erasableSyntaxOnly": true,
    "types": ["node"]
  },
  "include": ["./src"]
}
